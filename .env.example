# Copy this file to `.env` and change what you need. Every line is optional.

# Which LLM answers the questions: "ollama" (free, local) or "anthropic" (Claude API)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b

# Only for LLM_PROVIDER=anthropic. Never commit your real key to GitHub!
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# "default" = small English model. For Arabic + English use:
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL=default

# Retrieval tuning
TOP_K=4
MAX_DISTANCE=0.7
CHUNK_SIZE=800
CHUNK_OVERLAP=150
